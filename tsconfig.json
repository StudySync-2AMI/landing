{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/ui": ["./src/components/ui"],
      "@/ui/*": [
        "./src/components/ui/*",
        "./src/components/ui/headers/*",
        "./src/components/ui/fasteners/*",
        "./src/components/ui/paper/*",
        "./src/components/ui/annotations/*",
        "./src/components/ui/navigation/*",
        "./src/components/ui/orbit/*"
      ],
      "@/layout/*": ["./src/components/layout/*"],
      "@/sections/*": ["./src/components/sections/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
